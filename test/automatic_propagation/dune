(test
 (name automatic_propagation_runtime_test)
 (modules automatic_propagation_runtime_test)
 (libraries
  hamlet
  automatic_propagation_external
  hamlet_subtractor_generic_helper_producer
  alcotest)
 (preprocess
  (staged_pps hamlet-subtractor.ppx)))

(rule
 (targets automatic_propagation_types.actual)
 (deps
  .automatic_propagation_positive.objs/byte/automatic_propagation_positive.cmt)
 (action
  (with-stdout-to
   %{targets}
   (run ./automatic_propagation_cmt_dump.exe %{deps}))))

(rule
 (alias runtest)
 (action
  (diff
   automatic_propagation_types.expected
   automatic_propagation_types.actual)))

(rule
 (targets generic_helper_types.actual)
 (deps
  ../../subtractor/integration/.hamlet_subtractor_generic_helper_consumer.objs/byte/hamlet_subtractor_generic_helper_consumer.cmt)
 (action
  (with-stdout-to
   %{targets}
   (run ./automatic_propagation_cmt_dump.exe %{deps}))))

(rule
 (alias runtest)
 (action
  (diff generic_helper_types.expected generic_helper_types.actual)))

(rule
 (alias automatic-propagation-lsp)
 (deps
  .automatic_propagation_positive.objs/byte/automatic_propagation_positive.cmt
  automatic_propagation_positive.ml
  automatic_propagation_lsp_client.exe)
 (action
  (chdir
   %{workspace_root}
   (run
    %{exe:automatic_propagation_lsp_client.exe}
    %{workspace_root}
    %{workspace_root}/test/automatic_propagation/automatic_propagation_positive.ml
    case_error_cross_subset))))

(alias
 (name automatic-propagation-build-prerequisites)
 (deps
  .automatic_propagation_type_reference.objs/byte/automatic_propagation_type_reference.cmt
  .automatic_propagation_positive.objs/byte/automatic_propagation_positive.cmt
  automatic_propagation_types.actual
  automatic_propagation_cmt_dump.exe
  automatic_propagation_expansion_dump.exe
  automatic_propagation_merlin_source.exe
  automatic_propagation_merlin_type.exe
  automatic_propagation_lsp_client.exe))

(alias
 (name automatic-propagation-prerequisites)
 (deps
  (alias automatic-propagation-build-prerequisites)
  (alias automatic-propagation-lsp)))

(rule
 (alias runtest)
 (deps
  (sandbox none)
  run_acceptance.sh
  (alias automatic-propagation-prerequisites))
 (action
  (setenv
   HAMLET_SUBTRACTOR_DUNE_ACTION
   1
   (run %{dep:run_acceptance.sh}))))

(alias
 (name automatic-propagation-acceptance)
 (deps
  (alias runtest)))
