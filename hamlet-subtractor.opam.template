# Hamlet is not published in opam yet. Pin both packages from the same source
# so an `opam install` of Hamlet Subtractor has the complete effect-system
# dependency graph without a separately managed local checkout.
pin-depends: [
  [ "hamlet.dev"
    "git+https://github.com/hamlet-org/hamlet.git#main" ]
  [ "ppx_hamlet.dev"
    "git+https://github.com/hamlet-org/hamlet.git#main" ]
]
