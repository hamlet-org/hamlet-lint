(executable
 (name hamlet_subtractor_resolver)
 (modules hamlet_subtractor_resolver)
 (libraries hamlet_subtractor_private))

(install
 (package hamlet-subtractor)
 (section
  (site
   (hamlet-subtractor resolver)))
 (files
  (hamlet_subtractor_resolver.exe as hamlet-subtractor-resolver)))

(rule
 (targets hamlet_subtractor_resolver_ready.ml)
 (deps hamlet_subtractor_resolver.exe)
 (action
  (with-stdout-to
   %{targets}
   (echo "let built = ()"))))

(generate_sites_module
 (module hamlet_subtractor_sites)
 (sites hamlet-subtractor))

(library
