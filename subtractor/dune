 (foreign_stubs
  (language c)
  (names hamlet_subtractor_monotonic_stubs))
 (libraries
  compiler-libs.common
  dune-site
  hamlet_subtractor_core
  hamlet_subtractor_engine
  hamlet_subtractor_private
  ppxlib
  unix))

(rule
 (targets hamlet_subtractor_version.ml)
 (action
  (with-stdout-to
   %{targets}
   (echo
    "let configured = \"%{version:hamlet-subtractor}\"\\nlet value = if configured = \"\" then \"dev\" else configured"))))

