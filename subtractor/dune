(library
 (name hamlet_subtractor_engine)
 (public_name hamlet-subtractor.engine)
 (wrapped false)
 (modules
  hamlet_subtractor_catalogue
  hamlet_subtractor_engine
  hamlet_subtractor_generator
  hamlet_subtractor_replace
  hamlet_subtractor_resolver_protocol)
 (libraries hamlet_subtractor_core ppxlib yojson)
 (preprocess
  (pps ppxlib.metaquot)))

(library
 (name hamlet_subtractor_private)
 (package hamlet-subtractor)
 (wrapped false)
 (modules
  hamlet_subtractor_compiler_compat
  hamlet_subtractor_compiler_evidence
