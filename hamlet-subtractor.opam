opam-version: "2.0"
synopsis: "Exact automatic propagation for Hamlet"
description:
  "Compiler-assisted automatic propagation for Hamlet. The package installs hamlet-subtractor.ppx together with its matching compiler-libs resolver."
maintainer: ["Andrea Simone Costa <andreasimonecosta@gmail.com>"]
authors: ["Andrea Simone Costa <andreasimonecosta@gmail.com>"]
license: "MIT"
homepage: "https://github.com/hamlet-org/hamlet-subtractor"
bug-reports: "https://github.com/hamlet-org/hamlet-subtractor/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {= "5.5.0"}
  "hamlet"
  "ppx_hamlet"
  "ppxlib" {>= "0.38.0"}
  "dune-site"
  "yojson" {>= "2.0.0"}
  "alcotest" {>= "1.7.0" & with-test}
  "merlin" {with-test}
  "fmt" {>= "0.11.0" & with-test}
  "odoc" {with-doc}
  "ocamlformat" {= "0.29.0" & with-dev-setup}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "--promote-install-files=false"
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
  ["dune" "install" "-p" name "--create-install-files" name]
]
dev-repo: "git+https://github.com/hamlet-org/hamlet-subtractor.git"
